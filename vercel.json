{
  "builds": [
    {
      "src": "server/app.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": [
          "server/public/**",
          "server/static/**",
          "server/*.py",
          "research/**",
          "mcp/**",
          "memory/**",
          "models.py",
          ".env"
        ]
      }
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "server/app.py"
    }
  ]
}